# Copy this file to .env and adjust values as needed.
# No API keys are required — this backend runs entirely offline
# using TF-IDF + Multinomial Naive Bayes (no external AI APIs).

ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=*

UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MODEL_DIR=./data/trained_models

# "pandas" = local dev mode (default, no cluster needed)
# "spark"  = real Hadoop/Spark deployment
PROCESSING_ENGINE=pandas

# Only used when PROCESSING_ENGINE=spark
HDFS_NAMENODE_URL=hdfs://localhost:9000
SPARK_MASTER_URL=local[*]

TFIDF_MAX_FEATURES=5000
NB_ALPHA=1.0
TEST_SPLIT_SIZE=0.2
RANDOM_STATE=42

MAX_UPLOAD_SIZE_MB=50

# --- Application login (different from Facebook Graph API credentials) ---
# Generate a long random value for production, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_MINUTES=60

# --- Real Apache Hadoop WebHDFS storage ---
# Example for single-node Hadoop: http://localhost:9870/webhdfs/v1
# Leave empty to keep HDFS disabled; SQLite continues to preserve records.
HDFS_WEBHDFS_URL=
HDFS_USER=
HDFS_DATANODE_HOST_OVERRIDE=
HDFS_ROOT_PATH=/social-media-analytics
HDFS_TIMEOUT_SECONDS=10

# --- Facebook Meta Graph API ---
# Paste your User or Page Access Token from Meta for Developers (Graph API Explorer)
META_ACCESS_TOKEN=your_meta_access_token_here
META_API_VERSION=v21.0

# Facebook Settings
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_PAGE_ID=me
# Optional linked Instagram Professional account identifiers. Leave blank to discover from the selected/managed Page.
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
# Fernet key for encrypted backend token persistence. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# --- Crisis Monitoring & Alerts ---
ALERT_NEGATIVE_THRESHOLD=35.0
ALERT_MIN_SAMPLE_SIZE=3
