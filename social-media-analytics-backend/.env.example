# Copy this file to .env and adjust values as needed.
# No API keys are required — this backend runs entirely offline
# using TF-IDF + Multinomial Naive Bayes (no external AI APIs).

ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=*

UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MODEL_DIR=./data/trained_models

# "pandas" = local dev mode (default, no cluster needed)
# "spark"  = real Hadoop/Spark deployment
PROCESSING_ENGINE=pandas

# Only used when PROCESSING_ENGINE=spark
HDFS_NAMENODE_URL=hdfs://localhost:9000
SPARK_MASTER_URL=local[*]

TFIDF_MAX_FEATURES=5000
NB_ALPHA=1.0
TEST_SPLIT_SIZE=0.2
RANDOM_STATE=42

MAX_UPLOAD_SIZE_MB=50

# --- Meta Graph API (Facebook & Instagram) ---
# Paste your User or Page Access Token from Meta for Developers (Graph API Explorer)
META_ACCESS_TOKEN=your_meta_access_token_here
META_API_VERSION=v21.0

# Facebook Settings
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_PAGE_ID=me

# Instagram Settings (Uses Meta Graph API via linked Facebook Page or direct Professional account)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=auto

# --- Crisis Monitoring & Alerts ---
ALERT_NEGATIVE_THRESHOLD=35.0
ALERT_MIN_SAMPLE_SIZE=3
